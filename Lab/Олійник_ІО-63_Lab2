#include <stdio.h>
#include <math.h>

int main () {
    int n;
    printf("Vvedit n");
    if (scanf("%d", &n) != 1 || n < 1) {
        printf("Pomilka! n>= 1.\n");
        return 1;
    }

    double x = 0.5;
    double S = 0.0;
    long long lich = 0;

    lich += 2;

    for (int i = 1; i <= n; i++) {
        lich += 3;

        double a = 1.0;
        lich++;

        int b = i + 1;
        lich += 2;

        for (int j = 0; j < b; j++) {
            lich += 3;
            a = -a;
            lich += 2;
        }

        double c = 1.0;
        lich++;

        int d = 2 * i - 1;
        lich += 3;

        for (int j = 0; j < d; j++) {
            c *= 2.0;
            lich += 3;
        }
        double e = 1.0;
        lich++;

        int l = 2 * i;
        lich += 2;

        for (int j = 0; j < l; j++) {
            e *= x;
            lich += 3;
        }
        double f = 1.0;
        lich++;

        int g = 2 * i;
        lich += 2;

        for (int j = 1; j <= g; j++) {
            f *= j;
            lich += 4;
        }
        double sigma = (a * c * e) / f;
        lich += 4;

        S += sigma;
        lich += 2;
    }
    printf("Results S = %7f\n", S);
    printf("The number of operations: %lld\n", lich);
}

